# =============================================================================
# Sentinel — environment configuration (EXAMPLE)
# Copy to .env.local for the web app and configure Supabase Edge Function
# secrets via `supabase secrets set` / Supabase Vault. NEVER commit real values.
# =============================================================================

# --- Frontend (apps/web) — safe, publishable values only ---------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# --- Edge Functions / server-side secrets (set in Supabase Vault, NOT here) ---
# Stored via: supabase secrets set KEY=value   (kept out of git)
#
# ANTHROPIC_API_KEY=sk-ant-...                # AI analysis layer
# GOOGLE_SERVICE_ACCOUNT_JSON={...}           # base64 or raw JSON of the SA key
# GOOGLE_ADMIN_IMPERSONATE_EMAIL=admin@visionfreights.com  # super-admin to impersonate (DWD)
# WHATSAPP_TOKEN=                             # WhatsApp Business Cloud API token
# WHATSAPP_PHONE_NUMBER_ID=                   # WhatsApp Business phone-number-id
# ALERT_FROM_EMAIL=compliance@visionfreights.com
# SMTP_URL=                                   # optional: smtp://user:pass@host:port for prod email
# SUPABASE_SERVICE_ROLE_KEY=                  # injected automatically in deployed functions
